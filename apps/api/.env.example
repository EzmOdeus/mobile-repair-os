# ==========================================================
#  Mobile Repair OS Egypt - API environment
#  انسخ الملف ده إلى .env وعدّل القيم
# ==========================================================

NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# --- MongoDB (بديل Supabase PostgreSQL) ---
MONGODB_URI=mongodb://127.0.0.1:27017/mobile_repair_os
MONGODB_MAX_POOL_SIZE=20

# --- JWT (بديل Supabase Auth) ---
JWT_ACCESS_SECRET=change-me-access-secret-min-32-characters-long
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-characters-long
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
# مفتاح مستقل لتشفير أسرار المصادقة الثنائية (موصى به في الإنتاج).
# إن تُرك فارغًا يُشتق من JWT_ACCESS_SECRET — وتغيير الـJWT وقتها يُبطل كل أسرار 2FA.
TWO_FACTOR_ENCRYPTION_KEY=
TWO_FACTOR_CHALLENGE_TTL_MINUTES=5

# --- Local file storage (بديل Supabase Storage) ---
# على Vercel: استخدم STORAGE_DRIVER=s3 إجباريًا (القرص للقراءة فقط/غير دائم)،
# واضبط UPLOAD_MAX_FILE_MB=4 لأن حد جسم الطلب في Vercel هو 4.5MB.
UPLOAD_DIR=./uploads
UPLOAD_MAX_FILE_MB=8
PUBLIC_API_URL=http://localhost:4000
# سرّ توقيع روابط الملفات (اختياري). إن تُرك فارغًا يُستخدم JWT_ACCESS_SECRET.
UPLOAD_URL_SECRET=
# صلاحية روابط الملفات الموقّعة بالدقائق
UPLOAD_URL_TTL_MINUTES=120

# --- التخزين السحابي (اختياري): AWS S3 / Cloudflare R2 / MinIO ---
# افتراضيًا الملفات على القرص المحلي. عند التحويل لـS3/R2 اضبط driver=s3
# وسكيمة مفاتيح التخزين تفضل كما هي: <orgId>/<kind>/<yyyy>/<mm>/...
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# اضبط true مع R2/MinIO
S3_FORCE_PATH_STYLE=false

# --- CORS: قائمة الويب المسموح بها، مفصولة بفواصل ---
# ملاحظة: في وضع التطوير يُسمح أيضًا بأي منفذ على localhost/127.0.0.1،
# لأن Next.js ينتقل تلقائيًا للمنفذ 3001 لو كان 3000 مشغولًا.
# في الإنتاج تبقى هذه القائمة هي المرجع الوحيد.
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=600
AUTH_RATE_LIMIT_MAX=30

# --- Vercel Cron / أي مجدول خارجي ---
# Vercel يرسل Authorization: Bearer <CRON_SECRET> إلى مسارات /api/v1/internal/cron/*
# مطلوب في الإنتاج على Vercel، وإلا سترفض المسارات الطلبات.
CRON_SECRET=

# --- Client portal ---
PUBLIC_WEB_URL=http://localhost:3000

# --- مهمة فحص SLA الدورية (داخل الـAPI) ---
SLA_SCAN_INTERVAL_MINUTES=5

# --- الاشتراكات: التجربة والجدولة والمهلة والتذكيرات ---
TRIAL_DAYS=14
SUBSCRIPTION_SCAN_INTERVAL_MINUTES=60
SUBSCRIPTION_GRACE_DAYS=7
# أيام إرسال تذكير قبل الانتهاء (مفصولة بفواصل) — مرة واحدة لكل يوم لكل دورة اشتراك
SUBSCRIPTION_REMINDER_DAYS=7,3,1

# --- النسخ الاحتياطي (نسخة منطقية JSON لكل القاعدة + ملفات uploads) ---
# تعمل تلقائيًا كل 24 ساعة وتُحفظ آخر 14 نسخة (JSON + لقطة uploads بنفس الطابع الزمني).
# مع STORAGE_DRIVER=s3 تُنسخ الملفات من المزوّد (Versioning) ولا تُنسخ محليًا.
# على Vercel: اضبط BACKUP_ENABLED=false واستخدم النسخ التلقائي في MongoDB Atlas
# (نظام الملفات هناك غير دائم، وسكربت النسخ المحلي يرفض العمل على Vercel).
BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_COUNT=14
BACKUP_DIR=./backups
BACKUP_INCLUDE_UPLOADS=true

# --- Default bootstrap org settings ---
DEFAULT_CURRENCY=EGP
DEFAULT_TIMEZONE=Africa/Cairo
DEFAULT_LOCALE=ar-EG

# --- WhatsApp Cloud API (اختياري) ---
WHATSAPP_MODE=log
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v21.0
# قوالب Meta المعتمدة. بدون قالب يُرسل نص حر (مسموح فقط داخل نافذة 24 ساعة).
# WHATSAPP_TEMPLATE_MAP={"ready_for_pickup":{"name":"repair_ready","language":"ar","params":["customerName","device","total","ticketNumber"]}}

# --- SMS عبر بوابة HTTP (اختياري) ---
# تُرسل POST JSON بالشكل: { "to": "01...", "message": "...", "sender": "..." }
SMS_MODE=log
SMS_API_URL=
SMS_API_KEY=
SMS_SENDER=
SMS_TIMEOUT_MS=10000

# إعادة المحاولة عند فشل مزوّد الرسائل (شبكة/429/5xx)
NOTIFICATION_MAX_ATTEMPTS=3

# --- تهيئة أول مدير منصة على قاعدة إنتاج فارغة (سكربت bootstrap فقط) ---
# لا تُضف هذه القيم إلى متغيرات Vercel وقت التشغيل؛ استخدمها محليًا مع:
#   npm run bootstrap:platform
# PLATFORM_ADMIN_PASSWORD=
# PLATFORM_ADMIN_USERNAME=platform.admin
