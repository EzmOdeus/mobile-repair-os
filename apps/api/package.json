{
  "name": "@mros/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Mobile Repair OS Egypt - Express + MongoDB API",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-swagger-ui.mjs",
    "start": "node dist/server.js",
    "dev": "node dist/server.js",
    "dev:watch": "tsx watch --clear-screen=false src/server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "seed": "node dist/scripts/seed.js",
    "seed:reset": "node dist/scripts/seed.js --reset",
    "seed:ts": "tsx src/scripts/seed.ts",
    "seed:ts:reset": "tsx src/scripts/seed.ts --reset",
    "bootstrap:platform": "node dist/scripts/bootstrap-platform-admin.js",
    "e2e": "node dist/scripts/e2e-flow.js",
    "fix:indexes": "node dist/scripts/fix-indexes.js",
    "fix:indexes:dry": "node dist/scripts/fix-indexes.js --dry",
    "fix:counters": "node dist/scripts/fix-counters.js",
    "fix:counters:dry": "node dist/scripts/fix-counters.js --dry",
    "audit:finance": "node dist/scripts/audit-dev-data.js",
    "audit:finance:ts": "tsx src/scripts/audit-dev-data.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1146.0",
    "bcryptjs": "3.0.3",
    "bidi-js": "1.0.3",
    "compression": "1.8.1",
    "cors": "2.8.6",
    "dayjs": "1.11.23",
    "dotenv": "17.2.4",
    "express": "5.2.1",
    "express-rate-limit": "8.7.0",
    "helmet": "8.3.0",
    "jsonwebtoken": "9.0.3",
    "mongoose": "8.24.4",
    "morgan": "1.12.1",
    "multer": "2.4.0",
    "pdfkit": "0.17.2",
    "pino": "10.4.0",
    "qrcode": "1.5.4",
    "swagger-ui-express": "5.0.1",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/compression": "1.8.1",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jsonwebtoken": "9.0.10",
    "@types/morgan": "1.9.10",
    "@types/multer": "2.0.0",
    "@types/node": "24.10.1",
    "@types/pdfkit": "0.17.3",
    "@types/qrcode": "1.5.6",
    "@types/supertest": "6.0.3",
    "@types/swagger-ui-express": "4.1.8",
    "mongodb-memory-server": "11.3.0",
    "supertest": "7.3.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
