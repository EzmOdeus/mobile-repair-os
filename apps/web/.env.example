# عنوان الـAPI الذي تستدعيه الواجهة
# على Vercel (مشروع واحد بخدمتي web + api): يمكن تركه فارغًا — الافتراضي /api/v1
# على Vercel (مشروعان منفصلان): https://<api-domain>/api/v1
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# عنوان تحميل الملفات المرفوعة
NEXT_PUBLIC_UPLOADS_URL=http://localhost:4000/uploads

NEXT_PUBLIC_APP_NAME=Mobile Repair OS

# منفذ الواجهة (اختياري — الافتراضي 3000)
# PORT=3000
