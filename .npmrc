# ==========================================================
#  إعدادات npm للمشروع
# ==========================================================

# npm workspaces: تُدار الحزم من الجذر عبر حقل workspaces في package.json
# (لا حاجة لإعداد خاص — npm يرفع الحزم المشتركة تلقائيًا إلى node_modules الجذر)

save-exact=true
fund=false
audit=false
loglevel=error

# مهم: cache داخل المشروع.
# السبب أن بعض البيئات المقيَّدة (sandbox) تمنع الكتابة في مجلد الـcache العام
# فيفشل npm بـEPERM. الـcache المحلي يجعل التثبيت يعمل في كل البيئات.
cache=.npm-cache

engine-strict=false
